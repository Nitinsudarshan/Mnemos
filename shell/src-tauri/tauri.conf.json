{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shell",
  "version": "0.1.0",
  "identifier": "com.nitin.shell",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "shell",
        "width": 800,
        "height": 600
      },
      {
        "label": "indicator",
        "title": "Mnemos Listening",
        "url": "indicator.html",
        "width": 200,
        "height": 60,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}